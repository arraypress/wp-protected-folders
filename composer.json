{
    "name": "arraypress/wp-protected-folders",
    "description": "Upload folders a web server refuses to serve, and a local delivery path that hands off to object storage when there is one.",
    "type": "library",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "David Sherlock",
            "homepage": "https://arraypress.com/"
        }
    ],
    "require": {
        "php": ">=8.3",
        "arraypress/wp-file-utils": "dev-main",
        "arraypress/wp-server-utils": "dev-main"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "autoload": {
        "psr-4": {
            "ArrayPress\\ProtectedFolders\\": "src/"
        },
        "files": [
            "src/Functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "ArrayPress\\ProtectedFolders\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "vcs", "url": "https://github.com/arraypress/wp-file-utils.git" },
        { "type": "vcs", "url": "https://github.com/arraypress/wp-server-utils.git" }
    ],
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "format": "phpcbf --standard=phpcs-format.xml.dist",
        "format:check": "phpcs --standard=phpcs-format.xml.dist"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": false
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/arraypress/wp-protected-folders/issues",
        "source": "https://github.com/arraypress/wp-protected-folders"
    },
    "keywords": [
        "wordpress",
        "downloads",
        "file-delivery",
        "htaccess",
        "x-sendfile",
        "uploads"
    ]
}
